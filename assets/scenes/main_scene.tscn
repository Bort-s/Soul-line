[sub_resource type="GDScript" id="GDScript_vo808"]
script/source = "extends CharacterBody2D

const MAXSPEED = 300.0
const ACCELERATION = 670
const JUMP_VELOCITY = -350.0
const COYOTETIME = 0.13

var GRAVITY = 981
var currentCoyote = 0
var inCoyoteTime = false
var intro_finished = false

@onready var sprite = $AnimatedSprite2D

func _ready():
	add_to_group(\"player\")
	
	sprite.play(\"intro\")
	sprite.animation_finished.connect(_on_intro_finished)

func _on_intro_finished():
	intro_finished = true

func _physics_process(delta: float) -> void:
	if not intro_finished:
		return
		
	if is_on_floor():
		currentCoyote = 0
	
	# Lógica del Coyote
	if not is_on_floor():
		if currentCoyote < COYOTETIME:
			currentCoyote += delta
			inCoyoteTime = true
		else:
			inCoyoteTime = false

	# Salto
	if Input.is_action_just_pressed(\"jump\") and (is_on_floor() or inCoyoteTime):
		velocity.y = JUMP_VELOCITY
		inCoyoteTime = false
		
	if not is_on_floor():
		velocity.y += GRAVITY * delta

	var direction := Input.get_axis(\"left\", \"right\")
	if direction:
		velocity.x = move_toward(velocity.x, MAXSPEED*direction, ACCELERATION * delta)
		if velocity.x < 100:
			$AnimatedSprite2D.flip_h = direction < 0
	else:
		velocity.x = move_toward(velocity.x, 0, ACCELERATION * delta * 10)
		
	# Caída al vacío (Respawn)
	if position.y > 700:
		position = Vector2(-110, 0)
		velocity = Vector2.ZERO

	move_and_slide()
"

