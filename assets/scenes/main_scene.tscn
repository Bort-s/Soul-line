[sub_resource type="GDScript" id="GDScript_0ft0v"]
script/source = "extends Area2D

@export var player: Node2D

# Subí un poco la velocidad, ya que 0.0001 dividido entre una distancia (ej. 100) 
# daría un número tan pequeño que no verías la rotación. Ajusta este número a tu gusto.
const WSPEED = 50000.0 

func _process(delta: float) -> void:
	# Verificamos que el nodo player esté asignado para evitar errores
	if player:
		var distance = global_position.distance_to(player.global_position)
		rotation_degrees += delta * (1 / (distance / WSPEED))
	

func _on_body_entered(body: Node2D) -> void:
	print(\"Detecté algo: \", body.name) # Nos dirá si está detectando cualquier cuerpo
	if body.is_in_group(\"player\"):
		print(\"¡Es el jugador! Saliendo...\")
		get_tree().quit()
"

